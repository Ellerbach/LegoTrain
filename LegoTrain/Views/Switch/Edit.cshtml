@model LegoTrain.Models.Switch

<h2>Edit a switch</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            @Html.HiddenFor(model => model.Id)
            <div class="form-group">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })
                @Html.EditorFor(model => model.Name, new { @class = "form-control" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.X, new { @class = "control-label" })
                @Html.EditorFor(model => model.X, new { @class = "form-control" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Y, new { @class = "control-label" })
                @Html.EditorFor(model => model.Y, new { @class = "form-control" })
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.Rotation, new { @class = "control-label" })
                @Html.EditorFor(model => model.Rotation, new { @class = "form-control" })
                <input type="range" id="rotationSlider" min="-360" max="360" value="@Model.Rotation" class="form-range mt-2" />
            </div>
            <div class="form-group">
                @Html.LabelFor(model => model.IsLeft, new { @class = "control-label" })
                @Html.CheckBoxFor(model => model.IsLeft, new { @class = "form-check-label" })
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>

        <div>
            <a asp-action="Index">Back to List</a>
        </div>
    </div>
    <div class="col-md-8">
        <div style="position: relative; display: inline-block;">
            <img id="circuitMap" src="/config/circuit.png" alt="Circuit Map" style="max-width: 100%; border: 1px solid #ccc;" />
            <img id="switchIcon" src="/config/switch-left-str.png" alt="Switch" style="position: absolute; cursor: move;" />
        </div>
        <div class="mt-2">
            <small class="text-muted">Drag the switch icon to position it. Use the rotation slider or input to rotate. Toggle the checkbox to change switch type (left/right).</small>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let isDragging = false;
        const switchIcon = document.getElementById('switchIcon');
        const circuitMap = document.getElementById('circuitMap');
        const xInput = document.getElementById('X');
        const yInput = document.getElementById('Y');
        const rotationInput = document.getElementById('Rotation');
        const rotationSlider = document.getElementById('rotationSlider');
        const isLeftCheck = document.getElementById('IsLeft');

        // Debug: Check if elements are found
        console.log('Elements found:', {
            switchIcon: !!switchIcon,
            circuitMap: !!circuitMap,
            xInput: !!xInput,
            yInput: !!yInput,
            rotationInput: !!rotationInput,
            rotationSlider: !!rotationSlider,
            isLeftCheck: !!isLeftCheck
        });

        if (!switchIcon || !circuitMap || !xInput || !yInput || !rotationInput || !rotationSlider || !isLeftCheck) {
            console.error('Some required elements were not found');
            return;
        }

        function updatePosition() {
            const x = parseInt(xInput.value) || 0;
            const y = parseInt(yInput.value) || 0;
            
            // Scale coordinates to displayed size
            const scale = circuitMap.clientWidth / circuitMap.naturalWidth;
            const displayX = x * scale;
            const displayY = y * scale;
            
            switchIcon.style.left = displayX + 'px';
            switchIcon.style.top = displayY + 'px';
            
            // Scale icon size to match map scale
            const iconWidth = switchIcon.naturalWidth * scale;
            const iconHeight = switchIcon.naturalHeight * scale;
            switchIcon.style.width = iconWidth + 'px';
            switchIcon.style.height = iconHeight + 'px';
        }

        function updateRotation() {
            const rotation = parseInt(rotationInput.value) || 0;
            switchIcon.style.transform = `rotate(${rotation}deg)`;
            switchIcon.style.transformOrigin = 'center';
            rotationSlider.value = rotation;
        }

        function updateSwitchImage() {
            const isLeft = isLeftCheck.checked;
            const type = isLeft ? 'left' : 'right';
            switchIcon.src = `/config/switch-${type}-str.png`;
        }

        switchIcon.addEventListener('mousedown', (e) => {
            isDragging = true;
            e.preventDefault();
        });

        document.addEventListener('mousemove', (e) => {
            if (!isDragging) return;
            
            const rect = circuitMap.getBoundingClientRect();
            const x = e.clientX - rect.left - (switchIcon.width / 2);
            const y = e.clientY - rect.top - (switchIcon.height / 2);
            
            const clampedX = Math.max(0, Math.min(x, rect.width - switchIcon.width));
            const clampedY = Math.max(0, Math.min(y, rect.height - switchIcon.height));
            
            // Convert displayed coordinates to natural image coordinates
            const scale = circuitMap.clientWidth / circuitMap.naturalWidth;
            const naturalX = Math.round(clampedX / scale);
            const naturalY = Math.round(clampedY / scale);
            
            xInput.value = naturalX;
            yInput.value = naturalY;
            updatePosition();
        });

        document.addEventListener('mouseup', () => {
            isDragging = false;
        });

        xInput.addEventListener('input', updatePosition);
        yInput.addEventListener('input', updatePosition);
        rotationInput.addEventListener('input', () => {
            rotationSlider.value = rotationInput.value;
            updateRotation();
        });
        rotationSlider.addEventListener('input', () => {
            rotationInput.value = rotationSlider.value;
            updateRotation();
        });
        isLeftCheck.addEventListener('change', updateSwitchImage);

        // Initialize after image loads
        function initialize() {
            updatePosition();
            updateRotation();
            updateSwitchImage();
        }
        
        if (switchIcon.complete && switchIcon.naturalWidth > 0) {
            initialize();
        } else {
            switchIcon.addEventListener('load', initialize);
        }
        
        circuitMap.addEventListener('load', updatePosition);
    });
</script>